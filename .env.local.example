# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://nawastudio.com

# ── Supabase ──────────────────────────────────────────────────────────────────
# Récupérer dans : Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Cloudflare R2 (stockage des CV) ──────────────────────────────────────────
# Récupérer dans : Cloudflare Dashboard → R2 → Manage API tokens
R2_ENDPOINT=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ⚠️ RGPD : ces buckets DOIVENT avoir une Jurisdictional Restriction = European
# Union activée côté Cloudflare Dashboard (R2 → bucket → Settings) — un nom de
# bucket en "-eu" ne le garantit pas en soi, c'est un réglage à part. Sans ce
# nom exact posé ici, le code retombe sur "naywa-cv"/"naywa-logos" (ancien
# bucket, hors UE) — voir lib/r2-storage.ts.
R2_BUCKET_CV=naywa-cv-eu
R2_BUCKET_LOGOS=naywa-logos

# ── Spline 3D Scene ───────────────────────────────────────────────────────────
# Remplacer par l'URL de votre scène Spline (export → "Spline Viewer" → copy URL)
NEXT_PUBLIC_SPLINE_SCENE_URL=https://prod.spline.design/YOUR_SCENE_ID/scene.splinecode

# ── Analytics (optionnel) ────────────────────────────────────────────────────
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_GA_ID=G-...
